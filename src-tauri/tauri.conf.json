{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Debload",
  "version": "0.2.0",
  "identifier": "fr.baptiste.debload",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Debload",
        "width": 1360,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Installe et désinstalle des paquets .deb",
    "longDescription": "Debload installe un paquet .deb déposé dans sa fenêtre et désinstalle en un clic ce qu'il a installé.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "polkitd | policykit-1",
          "apt",
          "dpkg"
        ]
      }
    },
    "resources": {
      "repos.default.json": "repos.json"
    }
  }
}
